{
  "cli": {
    "version": ">= 24.3.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "node": "22.14.0"
    },
    "preview": {
      "distribution": "internal",
      "node": "22.14.0",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-attune.up.railway.app"
      }
    },
    "production": {
      "autoIncrement": true,
      "node": "22.14.0",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api-attune.up.railway.app"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
