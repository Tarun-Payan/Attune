# Local Docker infrastructure (docker-compose.yml)
DATABASE_URL=postgres://attune:attune@localhost:5432/attune
REDIS_URL=redis://localhost:6379

# API
API_PORT=3000
LOG_LEVEL=info

# Worker
HEARTBEAT_MS=60000

GITHUB_TOKEN=

JWT_SECRET=            # generate: openssl rand -hex 32
OAUTH_REDIRECT_BASE=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

SMTP_HOST=localhost            # local: Mailpit · prod: smtp.resend.com
SMTP_PORT=1025                 # local: 1025 · prod: 465
SMTP_USER=                     # local: empty · prod: resend
SMTP_PASS=                     # local: empty · prod: your Resend API key
MAIL_FROM=Attune <brief@attune.local>

# Alternative to SMTP: Gmail REST API over HTTPS (e.g. for Railway where SMTP ports 465/587 are blocked)
# GMAIL_USER=your-email@gmail.com
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

FIREBASE_SERVICE_ACCOUNT=      # optional: FCM service-account JSON for store builds
APP_URL=http://localhost:3000  # links inside emails

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_RPM=15
AI_MAX_RPD=300
